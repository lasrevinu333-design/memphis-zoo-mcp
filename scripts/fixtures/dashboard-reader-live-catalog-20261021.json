  "view": {
    "owner": "postgres",
    "options": null,
    "definition_md5": "bab6b9acaa3aedd76b1eaf9a5eff699e",
    "definition_sql": " WITH op_day AS (\n         SELECT operational_day_start(now()) AS day_start,\n            sch_service_date(now()) AS service_date\n        ), authority AS (\n         SELECT state.service_date,\n            state.governed,\n            state.authority_source,\n            state.projection_status,\n            state.version_id,\n            state.publication_id,\n            state.projection_id,\n            state.projection_authority_revision,\n            state.staffing_authority_revision,\n            state.week_start\n           FROM op_day day\n             CROSS JOIN LATERAL static_weekly_v6_schedule_authority_state(day.service_date) state(service_date, governed, authority_source, projection_status, version_id, publication_id, projection_id, projection_authority_revision, staffing_authority_revision, week_start)\n        ), scheduled_baseline AS (\n         SELECT assignment.location_id,\n            min(((day.service_date + assignment.coverage_start) AT TIME ZONE 'America/Chicago'::text)) AS baseline_at\n           FROM op_day day\n             JOIN LATERAL custodial_operational_location_assignments(day.service_date) assignment(service_date, authority_source, projection_status, version_id, publication_id, projection_id, occurrence_id, location_group_id, group_code, group_name, assigned_employee_id, assigned_employee_name, assignment_status, coverage_start, coverage_end, location_id, location_code, location_name, form_type) ON true\n          GROUP BY assignment.location_id\n        ), latest_scan AS (\n         SELECT scan_events.location_id,\n            max(COALESCE(scan_events.scanned_at, scan_events.created_at)) AS last_scan_at\n           FROM scan_events\n          GROUP BY scan_events.location_id\n        ), open_session AS (\n         SELECT DISTINCT ON (work.location_id) work.location_id,\n            work.location_code,\n            work.session_id,\n            work.session_uuid,\n            work.status AS session_status,\n            work.started_at,\n            work.ended_at,\n            work.duration_minutes,\n            work.duration_display,\n            work.employee_name,\n            work.device_identifier\n           FROM custodial_open_work() work(open_work_id, source_kind, session_id, context_id, session_uuid, client_session_id, location_id, location_code, location_name, employee_id, employee_name, device_id, device_identifier, status, started_at, ended_at, duration_minutes, duration_display, created_at)\n          WHERE work.source_kind <> 'session'::text OR work.started_at >= operational_day_start(now())\n          ORDER BY work.location_id, work.started_at DESC, work.created_at DESC, work.open_work_id DESC\n        ), latest_completed AS (\n         SELECT DISTINCT ON (session.location_id) session.location_id,\n            session.id AS session_id,\n            session.session_uuid,\n            session.started_at,\n            session.ended_at,\n            session.duration_minutes,\n            session.duration_display,\n            employee.display_name AS employee_name,\n            completion.submitted_at,\n            completion.response_json,\n            COALESCE(session.ended_at, completion.submitted_at, session.started_at) AS effective_completed_at\n           FROM sessions session\n             JOIN employees employee ON employee.id = session.employee_id\n             LEFT JOIN completion_responses completion ON completion.session_id = session.id\n             CROSS JOIN op_day day\n          WHERE session.status = 'closed'::text AND COALESCE(session.ended_at, completion.submitted_at, session.started_at) >= day.day_start\n          ORDER BY session.location_id, (COALESCE(session.ended_at, completion.submitted_at, session.started_at)) DESC, session.started_at DESC\n        ), open_tickets AS (\n         SELECT maintenance_tickets.location_id,\n            count(*) AS open_ticket_count\n           FROM maintenance_tickets\n          WHERE maintenance_tickets.status = 'open'::text\n          GROUP BY maintenance_tickets.location_id\n        ), truth AS (\n         SELECT location.id AS location_id,\n            COALESCE(open_session.location_code, location.location_code) AS location_code,\n            location.location_name,\n            location.location_type,\n            location.form_type,\n            day.day_start,\n            latest_scan.last_scan_at,\n            open_session.session_id AS open_session_id,\n            open_session.session_uuid AS open_session_uuid,\n            open_session.session_status AS open_session_status,\n            open_session.started_at AS open_session_started_at,\n            open_session.ended_at AS open_session_ended_at,\n            open_session.employee_name AS open_session_employee_name,\n            open_session.device_identifier AS open_session_device_identifier,\n            latest_completed.session_id AS latest_completed_session_id,\n            latest_completed.session_uuid AS latest_completed_session_uuid,\n            latest_completed.started_at AS latest_started_at,\n            latest_completed.ended_at AS latest_ended_at,\n            latest_completed.submitted_at AS latest_submitted_at,\n            latest_completed.effective_completed_at AS latest_completed_at,\n            latest_completed.employee_name AS latest_employee_name,\n            latest_completed.duration_minutes,\n            latest_completed.duration_display,\n            latest_completed.response_json,\n            COALESCE(open_tickets.open_ticket_count, 0::bigint) AS open_ticket_count,\n            scheduled_baseline.baseline_at,\n                CASE\n                    WHEN scheduled_baseline.baseline_at IS NULL THEN NULL::timestamp with time zone\n                    ELSE GREATEST(COALESCE(latest_completed.effective_completed_at, scheduled_baseline.baseline_at), scheduled_baseline.baseline_at)\n                END AS due_baseline_at,\n            authority.authority_source AS schedule_authority_source,\n            authority.projection_status AS schedule_projection_status\n           FROM locations location\n             CROSS JOIN op_day day\n             CROSS JOIN authority\n             LEFT JOIN scheduled_baseline ON scheduled_baseline.location_id = location.id\n             LEFT JOIN latest_scan ON latest_scan.location_id = location.id\n             LEFT JOIN open_session ON open_session.location_id = location.id\n             LEFT JOIN latest_completed ON latest_completed.location_id = location.id\n             LEFT JOIN open_tickets ON open_tickets.location_id = location.id\n          WHERE location.active = true\n        )\n SELECT location_id,\n    location_code,\n    location_name,\n    location_type,\n    form_type,\n    day_start AS operational_day_start,\n    last_scan_at,\n    open_session_id,\n    open_session_uuid,\n    open_session_status,\n    open_session_started_at,\n    open_session_ended_at,\n    latest_completed_session_id,\n    latest_completed_session_uuid,\n    latest_started_at,\n    latest_ended_at,\n    latest_submitted_at,\n    latest_completed_at,\n    latest_employee_name,\n    duration_minutes,\n    duration_display,\n    COALESCE(response_json -> 'services_performed'::text, response_json -> 'servicesPerformed'::text, response_json -> 'services'::text, response_json -> 'completed_services'::text, response_json -> 'completedServices'::text, '[]'::jsonb) AS services_performed,\n    COALESCE(response_json ->> 'notes'::text, response_json ->> 'cleaning_notes'::text, response_json ->> 'cleaningNotes'::text, response_json ->> 'maintenance_notes'::text, response_json ->> 'maintenanceNotes'::text, response_json ->> 'other_service_performed'::text, response_json ->> 'otherServicePerformed'::text, response_json ->> 'note'::text) AS notes,\n    open_ticket_count,\n        CASE\n            WHEN open_session_status = ANY (ARRAY['active'::text, 'pending_submit'::text]) THEN 'in_progress'::text\n            WHEN due_baseline_at IS NULL THEN 'not_cleaned'::text\n            WHEN form_type = 'restroom'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('restroom_overdue_minutes'::text, 120))) THEN 'overdue'::text\n            WHEN form_type = 'restroom'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('restroom_due_soon_minutes'::text, 90))) THEN 'due_soon'::text\n            WHEN form_type = 'exhibit'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('exhibit_overdue_minutes'::text, 240))) THEN 'overdue'::text\n            WHEN form_type = 'exhibit'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('exhibit_due_soon_minutes'::text, 195))) THEN 'due_soon'::text\n            ELSE 'okay'::text\n        END AS status_code,\n        CASE\n            WHEN open_session_status = ANY (ARRAY['active'::text, 'pending_submit'::text]) THEN 'blue'::text\n            WHEN due_baseline_at IS NULL THEN 'black'::text\n            WHEN form_type = 'restroom'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('restroom_overdue_minutes'::text, 120))) OR form_type = 'exhibit'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('exhibit_overdue_minutes'::text, 240))) THEN 'red'::text\n            WHEN form_type = 'restroom'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('restroom_due_soon_minutes'::text, 90))) OR form_type = 'exhibit'::text AND now() >= (due_baseline_at + make_interval(mins => get_setting_int('exhibit_due_soon_minutes'::text, 195))) THEN 'yellow'::text\n            ELSE 'green'::text\n        END AS status_color,\n    to_char(timezone('America/Chicago'::text, day_start), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS operational_day_start_display,\n    to_char(timezone('America/Chicago'::text, last_scan_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS last_scan_at_display,\n    to_char(timezone('America/Chicago'::text, open_session_started_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS open_session_started_at_display,\n    to_char(timezone('America/Chicago'::text, open_session_ended_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS open_session_ended_at_display,\n    to_char(timezone('America/Chicago'::text, latest_started_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS latest_started_at_display,\n    to_char(timezone('America/Chicago'::text, latest_ended_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS latest_ended_at_display,\n    to_char(timezone('America/Chicago'::text, latest_submitted_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS latest_submitted_at_display,\n    to_char(timezone('America/Chicago'::text, latest_completed_at), 'MM/DD/YYYY HH12:MI AM'::text) || ' Central'::text AS latest_completed_at_display,\n    open_session_employee_name,\n    open_session_device_identifier,\n    schedule_authority_source,\n    schedule_projection_status\n   FROM truth;"
  },
